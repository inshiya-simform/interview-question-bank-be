generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum HistoryAction {
  CREATED
  UPDATED
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  REQUEST_CHANGES
  GRANT_ACCESS
  REVOKE_ACCESS
  LOGIN
  LOGIN_FAILED
  REGISTER
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET
  IMPORT
  EXPORT
}

enum AuditModule {
  AUTH
  USER
  CLIENT
  CLIENT_ACCESS
  QUESTION
}

enum QuestionStatus {
  PENDING_REVIEW
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

// Roles and permissions are data, not code: adding a role or changing what a
// role may do is a seed/data change. Client visibility is NOT modelled here;
// it stays in ClientPermission and in the query's WHERE clause.
model Role {
  id   Int    @id @default(autoincrement())
  name String @unique // SUPER_ADMIN | REVIEWER | USER

  permissions RolePermission[]
  users       User[]
}

model Permission {
  id   Int    @id @default(autoincrement())
  code String @unique // question:read | question:create | question:edit_own | question:review | user:read | user:create_staff | client:read_all | client:create | client:assign

  roles RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  name              String
  passwordHash      String
  // Tokens issued before this moment are rejected (set on password reset/change).
  passwordChangedAt DateTime?
  roleId            Int
  createdAt         DateTime  @default(now())

  role Role @relation(fields: [roleId], references: [id])

  questions           Question[]           @relation("QuestionAuthor")
  permissions         ClientPermission[]
  history             QuestionHistory[]
  reviewedQuestions   Question[]           @relation("QuestionReviewer")
  reviewLocks         QuestionReviewLock[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  auditLogs          AuditLog[]
  images              QuestionImage[]
  collections         Collection[]
  savedQuestions      SavedQuestion[]
  notifications       Notification[]
}

model Client {
  id   String @id @default(uuid())
  name String
  // Lowercased, whitespace-collapsed name; uniqueness is checked on this so "Acme" and "acme " collide.
  normalizedName String @unique

  permissions ClientPermission[]
  questions   Question[]
}

model ClientPermission {
  userId    String
  clientId  String
  grantedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([userId, clientId])
  @@index([clientId])
}

model TagCategory {
  id   Int    @id @default(autoincrement())
  slug String @unique // technology | seniority | question-type | ...
  name String

  tags Tag[]
}

model Tag {
  id         Int    @id @default(autoincrement())
  categoryId Int
  slug       String
  name       String

  category  TagCategory   @relation(fields: [categoryId], references: [id])
  questions QuestionTag[]

  @@unique([categoryId, slug])
  // Target of the composite FK from QuestionTag(tagId, categoryId)
  @@unique([id, categoryId])
}

model Question {
  id             String   @id @default(uuid())
  text           String
  normalizedText String // lowercased, punctuation/whitespace-collapsed; used by duplicate check
  answerNotes    String
  clientId       String? // NULL = visible to all authenticated users
  authorId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Review cycle. text/answerNotes/clientId/tags always hold the live approved
  // content once publishedAt is set; a pending edit of a published question
  // lives in QuestionDraft instead.
  status       QuestionStatus @default(PENDING_REVIEW)
  publishedAt  DateTime? // first approval; NULL = never visible to anyone but author/reviewers
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String? // latest change-request / rejection reason (optional for rejections)
  submittedAt  DateTime       @default(now()) // creation, and every author edit that (re)enters review

  // Generated column (see migration SQL); never written by the app.
  searchVector Unsupported("tsvector")?

  client  Client?           @relation(fields: [clientId], references: [id])
  author  User              @relation("QuestionAuthor", fields: [authorId], references: [id])
  tags    QuestionTag[]
  history QuestionHistory[]

  reviewedBy User?               @relation("QuestionReviewer", fields: [reviewedById], references: [id])
  draft      QuestionDraft?
  reviewLock QuestionReviewLock?
  savedBy    SavedQuestion[]

  @@index([clientId])
  @@index([authorId])
  @@index([status])
  @@index([publishedAt])
  @@index([status, submittedAt])
  @@index([searchVector], type: Gin, map: "Question_searchVector_idx")
  @@index([normalizedText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Question_normalizedText_trgm_idx")
}

// Pending edit of an already-published question; applied on approval, deleted on rejection.
// payload: { text, answerNotes, clientId, tags: [{ tagId, categoryId }] }
model QuestionDraft {
  id         String   @id @default(uuid())
  questionId String   @unique
  payload    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// Soft claim on a question that is being reviewed. A separate table (not columns on Question) so
// taking or renewing a lock never moves Question.updatedAt, which reviewers use as a version token.
// Expired rows are ignored and overwritten, so a closed tab never blocks a question for long.
model QuestionReviewLock {
  questionId String   @id
  lockedById String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  lockedBy User     @relation(fields: [lockedById], references: [id], onDelete: Cascade)
}

// categoryId is denormalised so a composite index can serve
// "category = X AND tag IN (...)" without joining Tag. The composite FK to
// Tag(id, categoryId) guarantees it always matches the tag's real category.
model QuestionTag {
  questionId String
  tagId      Int
  categoryId Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId, categoryId], references: [id, categoryId])

  @@id([questionId, tagId])
  @@index([tagId, questionId])
  @@index([categoryId, tagId, questionId])
}

model QuestionHistory {
  id         String        @id @default(uuid())
  questionId String
  actorId    String
  action     HistoryAction
  changes    Json // snapshot or before/after diff
  createdAt  DateTime      @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  actor    User     @relation(fields: [actorId], references: [id])

  @@index([questionId, createdAt])
}

// One-time password reset link. Only the sha256 of the emailed token is stored, so a database leak
// does not yield usable links. Consumed (usedAt) or expired rows are ignored.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Long-lived opaque refresh token; only its sha256 is stored. Each use rotates it (revokedAt set, a new
// row in the same familyId issued). Presenting a revoked token means it leaked, so the family is revoked.
model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  familyId    String
  expiresAt   DateTime
  revokedAt   DateTime?
  replacedById String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// System-wide activity trail, readable by the super admin only. actorEmail is a snapshot so the entry
// still says who acted after the user is deleted, and for failed logins where there is no actor row.
// changes: { field: { from, to } } for updates, otherwise a small metadata object. Never holds secrets.
model AuditLog {
  id         String      @id @default(uuid())
  action     AuditAction
  module     AuditModule
  entityId   String?
  actorId    String?
  actorEmail String
  changes    Json?
  createdAt  DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([module, createdAt])
  @@index([actorId, createdAt])
}

// Image uploaded for use inside rich-text answer notes. The bytes live in object storage (MinIO/S3);
// the note HTML references /api/v1/uploads/images/:id. Rows no note refers to are removed by the orphan sweep.
model QuestionImage {
  id          String   @id @default(uuid())
  objectKey   String   @unique
  mimeType    String
  size        Int
  createdById String
  createdAt   DateTime @default(now())

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([createdAt])
}

// A user's private folder for saved questions. normalizedName (lowercased, whitespace-collapsed) is
// what the per-user uniqueness is checked on, so "Frontend" and "frontend " collide.
model Collection {
  id             String   @id @default(uuid())
  userId         String
  name           String
  normalizedName String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  saved SavedQuestion[]

  @@unique([userId, normalizedName])
  // Target of the composite FK from SavedQuestion(collectionId, userId)
  @@unique([id, userId])
}

// A question lives in at most one of a user's collections (the PK), so "move" is an update of
// collectionId. The composite FK to Collection(id, userId) guarantees a user can only file a
// question into their own collection. Deleting a collection deletes its saved rows, not the questions.
model SavedQuestion {
  userId       String
  questionId   String
  collectionId String
  savedAt      DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId, userId], references: [id, userId], onDelete: Cascade)

  @@id([userId, questionId])
  @@index([collectionId, savedAt(sort: Desc)])
  @@index([questionId])
}

enum NotificationType {
  CLIENT_ACCESS_GRANTED
  CLIENT_ACCESS_REVOKED
  QUESTION_APPROVED
  QUESTION_CHANGES_REQUESTED
  QUESTION_REJECTED
  QUESTION_SUBMITTED
  CLIENT_QUESTION_ADDED
  IMPORT_FINISHED
}

// In-app notification. `data` holds ids and display names (questionId, clientId, ...); the client builds
// the copy and deep link from `type`, so wording changes never need a migration.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  data      Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}
