NODE_ENV=
PORT=
CORS_ORIGIN=
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=
DUPLICATE_SIMILARITY_THRESHOLD=

# Required by prisma seed (super admin)
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

# SendGrid (transactional email)
SENDGRID_API_KEY=
EMAIL_FROM=

# Password reset: base URL of the frontend (link is FRONTEND_URL/reset-password?token=...)
FRONTEND_URL=
PASSWORD_RESET_EXPIRY_MINUTES=

# Object storage for answer-note images (S3-compatible; RustFS via docker compose locally)
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=
# Public base URL of this API, used to build image URLs (e.g. https://api.example.com)
API_PUBLIC_URL=
